# Multi-stage image to reduce final size
FROM nvidia/cuda:11.8.0-devel-ubuntu22.04 AS builder
COPY --from=ghcr.io/astral-sh/uv:0.9.15 /uv /uvx /bin/

ARG USER_NAME=dreamer
ARG GROUP_NAME=dreamers
ARG UID=1000
ARG GID=1000

ENV TORCH_CUDA_ARCH_LIST="8.6"
ENV TCNN_CUDA_ARCHITECTURES="86"
ENV UV_LINK_MODE="copy"
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}
ENV LIBRARY_PATH=${CUDA_HOME}/lib64/stubs:${LIBRARY_PATH}
ENV CC=/usr/bin/gcc-10
ENV CXX=/usr/bin/g++-10
ENV TCNN_HALF_PRECISION=1

# Build-time dependencies only
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    curl \
    gcc-10 \
    g++-10 \
    git \
    libegl1-mesa-dev \
    libgl1-mesa-dev \
    libgles2-mesa-dev \
    libglib2.0-0 \
    libjpeg-dev \
    libpng-dev \
    ninja-build \
    pkg-config \
    python-is-python3 \
    python3.10 \
    python3.10-dev \
    python3.10-venv \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g ${GID} ${GROUP_NAME} && useradd -ms /bin/bash -u ${UID} -g ${GID} ${USER_NAME}
USER ${USER_NAME}
WORKDIR /home/${USER_NAME}

COPY --chown=${USER_NAME}:${GROUP_NAME} . /home/${USER_NAME}/threestudio
WORKDIR /home/${USER_NAME}/threestudio/custom/gaussians2life

# Build and vendor dependencies into .venv
RUN uv sync --locked

# --------------------- RUNTIME STAGE ---------------------
FROM nvidia/cuda:11.8.0-runtime-ubuntu22.04 AS runtime

ARG USER_NAME=dreamer
ARG GROUP_NAME=dreamers
ARG UID=1000
ARG GID=1000

ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}
ENV LIBRARY_PATH=${CUDA_HOME}/lib64/stubs:${LIBRARY_PATH}

# Runtime-only deps (drop dev toolchain)
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    curl \
    libegl1 \
    libgl1 \
    libgles2 \
    libglib2.0-0 \
    libjpeg8 \
    libpng16-16 \
    libsm6 \
    libtbb2 \
    libxext6 \
    libxrender1 \
    python-is-python3 \
    python3.10 \
    python3.10-venv \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -g ${GID} ${GROUP_NAME} && useradd -ms /bin/bash -u ${UID} -g ${GID} ${USER_NAME}
USER ${USER_NAME}
WORKDIR /home/${USER_NAME}

# Copy only what is needed for runtime
COPY --from=builder --chown=${USER_NAME}:${GROUP_NAME} /home/${USER_NAME}/threestudio /home/${USER_NAME}/threestudio

# Activate vendored venv
ENV PATH="/home/${USER_NAME}/threestudio/custom/gaussians2life/.venv/bin:${PATH}"
WORKDIR /home/${USER_NAME}/threestudio

CMD ["/bin/bash"]
